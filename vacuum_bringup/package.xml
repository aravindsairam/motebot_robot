<?xml version="1.0"?>
<package format="3">
  <name>vacuum_bringup</name>
  <version>0.1.0</version>
  <description>Launch file and configuration for the simulated vacuum robot: one bringup for mapping, localization and navigation, switched by the mode manager.</description>
  <maintainer email="noreply@example.com">sai</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>vacuum_mode_manager</exec_depend>
  <exec_depend>vacuum_safety</exec_depend>
  <exec_depend>apriltag_ros</exec_depend>
  <exec_depend>vacuum_docking</exec_depend>
  <exec_depend>vacuum_gateway</exec_depend>
  <exec_depend>vacuum_video</exec_depend>
  <exec_depend>vacuum_assistant</exec_depend>
  <exec_depend>vacuum_perception</exec_depend>
  <exec_depend>opennav_docking</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>python3-yaml</exec_depend>  <!-- the launch file reads the dock pose from docking.yaml -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
