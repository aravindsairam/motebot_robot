<?xml version="1.0"?>
<package format="3">
  <name>vacuum_assistant</name>
  <version>0.1.0</version>
  <description>The robot's assistant: answers questions about the robot in plain words, using a language model that looks things up on the robot through a small set of tools.</description>
  <maintainer email="noreply@example.com">sai</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>vacuum_interfaces</exec_depend>
  <exec_depend>vacuum_mode_manager</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
