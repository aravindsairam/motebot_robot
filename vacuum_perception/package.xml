<?xml version="1.0"?>
<package format="3">
  <name>vacuum_perception</name>
  <version>0.1.0</version>
  <description>The object finder: looks for things named in plain words in what the camera sees, and says where they are on the map using the depth camera.</description>
  <maintainer email="noreply@example.com">sai</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>vacuum_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
