<?xml version="1.0"?>
<package format="3">
  <name>vacuum_gateway</name>
  <version>0.1.0</version>
  <description>Passes messages between the robot and the Android app: one WebSocket carrying protobuf messages (proto/vacuum.proto at the project root). Holds no robot logic.</description>
  <maintainer email="noreply@example.com">sai</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>vacuum_interfaces</exec_depend>
  <exec_depend>vacuum_mode_manager</exec_depend>  <!-- map_files: where a map's zones file is -->
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- Also needs, from pip (not apt; Ubuntu 22.04's versions are too old):
       websockets >= 13 and protobuf >= 6.31. The node checks both at start-up. -->

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
